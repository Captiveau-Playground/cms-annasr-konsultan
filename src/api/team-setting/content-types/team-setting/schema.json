{
  "kind": "collectionType",
  "collectionName": "team_settings",
  "info": {
    "singularName": "team-setting",
    "pluralName": "team-settings",
    "displayName": "Team Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "default": "Mohammad Khusnul  Khakim, ST",
      "required": true
    },
    "position": {
      "type": "string",
      "default": "Tenaga Ahli",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "about_pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::about-us.about-us",
      "mappedBy": "team_setting"
    }
  }
}
