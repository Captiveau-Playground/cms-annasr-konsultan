{
  "kind": "collectionType",
  "collectionName": "portofolio_detail_settings",
  "info": {
    "singularName": "portofolio-detail-setting",
    "pluralName": "portofolio-detail-settings",
    "displayName": "Portofolio Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "title": {
      "type": "string",
      "default": "Pembangunan Gedung Serbaguna",
      "required": true
    },
    "address": {
      "type": "text",
      "default": "Kecamatan Jombang, Jombang",
      "required": true
    },
    "portofolio_category_settings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portofolio-category-setting.portofolio-category-setting",
      "mappedBy": "portofolio_detail_setting"
    },
    "service_settings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service-setting.service-setting",
      "inversedBy": "portofolio_settings"
    }
  }
}
