{
  "kind": "collectionType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "hero_tagline": {
      "type": "string",
      "default": "CV. An Nasr Konsultan",
      "required": true
    },
    "hero_description": {
      "type": "string",
      "default": "CV. AN NASR KONSULTAN menyediakan layanan perencanaan, pengawasan, perizinan, dan konstruksi dengan mengutamakan kualitas, profesionalisme, serta ketepatan dalam setiap tahap pekerjaan.",
      "required": true
    },
    "hero_bg_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "hero_contact_cta_text": {
      "type": "string",
      "default": "Konsultasi Sekarang",
      "required": true
    },
    "hero_service_cta_text": {
      "type": "string",
      "default": "Lihat layanan",
      "required": true
    },
    "service_tagline": {
      "type": "string",
      "default": "Layanan An Nasr dalam  Mendukung Proyek Anda",
      "required": true
    },
    "portfolio_tagline": {
      "type": "string",
      "default": "Ratusan Proyek yang Telah Kami Kawal",
      "required": true
    },
    "portfolio_cta_btn_text": {
      "type": "string",
      "default": "Lihat semua proyek",
      "required": true
    },
    "client_tagline": {
      "type": "string",
      "default": "Dipercaya instansi, lembaga, dan mitra usaha",
      "required": true
    },
    "founder_setting": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::founder-setting.founder-setting",
      "required": false
    },
    "company_setting": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company-setting.company-setting"
    },
    "service_setting": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::service-setting.service-setting"
    },
    "faq_settings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-setting.faq-setting",
      "mappedBy": "home_page"
    },
    "career_cta_title": {
      "type": "string",
      "default": "Bergabung Bersama Tim Kami",
      "required": true
    },
    "career_cta_description": {
      "type": "text",
      "default": "Kami membuka kesempatan bagi tenaga teknik, drafter, dan pengawas lapangan untuk berkembang bersama CV. AN NASR KONSULTAN.",
      "required": true
    },
    "career_cta_button_test": {
      "type": "string",
      "default": "Recruitment",
      "required": true
    },
    "location_tagline": {
      "type": "string",
      "default": "Kota dan daerah yang pernah kami tangani",
      "required": true
    },
    "fag_tagline": {
      "type": "string",
      "default": "Pertanyaan yang sering diajukan",
      "required": true
    },
    "fag_description": {
      "type": "text",
      "default": "Belum menemukan jawabannya? Tim kami siap membantu menjelaskan kebutuhan teknis proyek Anda.",
      "required": true
    },
    "faq_cta_btn_text": {
      "type": "string",
      "default": "Konsultasi Sekarang",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-components",
      "repeatable": true
    }
  }
}
