{
  "kind": "collectionType",
  "collectionName": "service_settings",
  "info": {
    "singularName": "service-setting",
    "pluralName": "service-settings",
    "displayName": "Service Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "default": "Layanan Kami",
      "required": true
    },
    "slug": {
      "type": "string",
      "default": "jasa-perencanaan",
      "required": true
    },
    "short_description": {
      "type": "text",
      "default": "Perencanaan teknis dan penyusunan desain yang matang, terukur, dan sesuai standar teknis yang berlaku.",
      "required": true
    },
    "hero_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "cta_btn_text": {
      "type": "string",
      "default": "Konsultasi Sekarang",
      "required": true
    },
    "section_2_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "section_2_description": {
      "type": "richtext",
      "required": true
    },
    "workflow_service_settings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::workflow-service-setting.workflow-service-setting",
      "inversedBy": "service_settings"
    },
    "requirment_service_settings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::requirment-service-setting.requirment-service-setting",
      "inversedBy": "service_settings"
    },
    "section_3_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "section_3_text": {
      "type": "richtext",
      "required": true
    },
    "portofolio_settings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::portofolio-detail-setting.portofolio-detail-setting",
      "mappedBy": "service_settings"
    }
  }
}
